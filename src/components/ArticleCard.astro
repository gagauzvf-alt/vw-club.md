---
import { t, l, formatDate, type Locale } from '../lib/i18n';
import type { Article } from '../lib/articles';
import { mediaForArticle } from '../lib/articleMedia';
import { avifSrcset, imageSrcset } from '../lib/images';

interface Props {
  article: Article;
  locale: Locale;
}
const { article, locale } = Astro.props;
const ui = t[locale];
const { title, description, date, type, model, cover } = article.data;
const resolvedCover = cover ?? mediaForArticle(article.id)[0]?.src;
const coverAlt = mediaForArticle(article.id)[0]?.alt[locale] ?? '';
---

<a class="card" href={l(locale, `/zhurnal/${article.id}/`)}>
  {resolvedCover && (
    <picture>
      <source type="image/avif" srcset={avifSrcset(resolvedCover)} sizes="(max-width: 640px) 100vw, (max-width: 1152px) 50vw, 368px" />
      <source type="image/webp" srcset={imageSrcset(resolvedCover)} sizes="(max-width: 640px) 100vw, (max-width: 1152px) 50vw, 368px" />
      <img class="card__cover" src={resolvedCover} alt={coverAlt} width="1200" height="675" loading="lazy" decoding="async" />
    </picture>
  )}
  <div class="card__body">
    <div class="card__meta">
      <span>{ui.typeLabel[type] ?? type}</span>
      {model.length > 0 && <span>{model.join(' · ')}</span>}
      <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
    </div>
    <h3 class="card__title">{title}</h3>
    <p class="card__desc">{description}</p>
  </div>
</a>

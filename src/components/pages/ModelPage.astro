---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../ArticleCard.astro';
import { SITE, t, l, type Locale } from '../../lib/i18n';
import type { ModelGroup } from '../../lib/articles';

interface Props {
  locale: Locale;
  group: ModelGroup;
  hasTranslation: boolean;
}
const { locale, group, hasTranslation } = Astro.props;
const ui = t[locale];
const path = `/models/${group.slug}/`;

const title = ui.modelPageTitle(group.model);
const intro = ui.modelPageIntro(group.model);

// CollectionPage связывает модельную страницу со статьями — механика GEO/AEO
const schema = {
  about: { '@type': 'Car', name: `Volkswagen ${group.model}`, brand: { '@type': 'Brand', name: 'Volkswagen' } },
};
---

<BaseLayout
  locale={locale}
  title={`${title} — VW Club Moldova`}
  description={intro}
  path={path}
  altPath={hasTranslation ? path : null}
  schema={schema}
  pageType="CollectionPage"
  crumbLabel={group.model}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Volkswagen {group.model}</p>
      <h1>{title}</h1>
      <p class="intro">{intro}</p>

      <h2 class="sub">{ui.articlesAbout}</h2>
      <div class="grid-cards">
        {group.articles.map((article) => <ArticleCard article={article} locale={locale} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { margin-block: var(--space-1) var(--space-2); }
  .intro { color: var(--c-text-soft); max-width: 42rem; }
  .sub { margin-block: var(--space-5) var(--space-3); font-size: var(--fs-h3); }
</style>
